.flex-col { flex-direction: column; }

.flex-wrap { flex-wrap: wrap; }

.flex-jc-between { justify-content: space-between; }

.flex-ai-start { align-items: flex-start; }

.flex-ai-end { align-items: flex-end; }

.flex-auto { flex: 1 1 auto; }

.v-enter-active, .v-leave-active { transition: opacity 0.2s ease-in; }

.v-enter, .v-leave-to { opacity: 0; }

.noleave-enter-active { transition: opacity 0.3s; }

.noleave-enter, .noleave-leave, .noleave-leave-active, .noleave-leave-to { =
opacity: 0; }

.none-enter-active { visibility: visible; }

.none-leave-active { visibility: hidden; }

.expand { position: relative; }

.expand::after { content: " "; height: 160%; left: -30%; position: absolute=
; top: -30%; width: 160%; }

.site-empty-tip { margin-top: 5rem; text-align: center; }

.site-empty-tip .info { color: rgb(136, 136, 136); font-size: 0.7rem; paddi=
ng-top: 0.5rem; }

.common-popup-container { margin: 0px auto; max-width: 750px; }

@media screen and (max-height: 480px) {
  .common-popup-container { max-width: 400px; }
}

html.web-mode .common-popup-container { max-width: 100%; }

.alipay-confirm.modal { color: rgb(85, 85, 85); }

.alipay-confirm.modal .modal-content { padding: 0.7rem 1.875rem 1rem; text-=
align: left; }

.alipay-confirm.modal .modal-button { color: rgb(22, 107, 254); }

.alipay-confirm.modal .modal-button.modal-button-cancel { color: rgb(30, 30=
, 30); font-weight: 400; }

.alipay-confirm.modal .modal-button.disabled { color: rgb(197, 197, 197); }

.alipay-confirm.modal.confirm-pad-normal .modal-content { padding: 0.8rem 0=
.8rem 1.2rem; }

.line-height-1 { line-height: 1; }

.fw-500 { font-weight: 500; }

.fw-600 { font-weight: 600; }

.h-full, body, html { height: 100%; }

body, html { background: rgb(245, 245, 245); color: rgb(30, 30, 30); }

html { overflow-y: scroll; }

body { font: 0.7rem / 1.7 "PingFang SC", "Microsoft Yahei", "Heiti SC", miu=
i, helvetica; height: 100%; margin: 0px auto; max-width: 750px; width: 100%=
; -webkit-font-smoothing: antialiased; overscroll-behavior-x: none; }

@media screen and (max-height: 480px) {
  body { max-width: 400px; }
}

html.web-mode body { max-width: 100%; }

